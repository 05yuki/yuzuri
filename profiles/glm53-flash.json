{
  "name": "glm53-flash",
  "description": "GLM-5.3-Flash: fp8 dense (--config-dir), NVFP4 experts beside it (--experts): NVFP4 CPU experts in kt-kernel, ModelOpt NVFP4 GPU experts through CUTLASS, the NVFP4 streamed prefill and the lends as Flash-Next's profile; measured 2026-11-05",
  "tree": "measured on kvcache-ai/sglang 541ddc3 with the lend modules of 2026-11-05",
  "weights": {
    "gguf": false,
    "experts_from": true,
    "embed_host": 0,
    "draft": "none",
    "draft_bytes_assumed": 0
  },
  "defaults": {
    "2": {
      "kv_dtype": "fp8",
      "mamba_slots": 1,
      "pools": 2,
      "free_min_gb": 1.0
    }
  },
  "command": [
    "-m",
    "sglang.launch_server",
    "--model-path",
    "{config_dir}",
    "--served-model-name",
    "{served_model_name}",
    "--host",
    "{host}",
    "--port",
    "{port}",
    "--tp",
    "{tp}",
    "--numa-node",
    "{numa_nodes}",
    "--disable-custom-all-reduce",
    "--kv-cache-dtype",
    "{kv_cache_dtype}",
    "--context-length",
    "{context_length}",
    "--max-total-tokens",
    "{context}",
    "--mem-fraction-static",
    "{mem_fraction}",
    "--max-running-requests",
    "1",
    "--page-size",
    "64",
    "--trust-remote-code",
    "--kt-weight-path",
    "{experts_dir}",
    "--kt-method",
    "NVFP4",
    "--kt-cpuinfer",
    "{threads}",
    "--kt-threadpool-count",
    "{pools}",
    "--kt-num-gpu-experts",
    "{hot}",
    "--kt-max-deferred-experts-per-token",
    "0",
    "--moe-runner-backend",
    "flashinfer_cutlass",
    "--fp4-gemm-backend",
    "flashinfer_cutlass",
    "--reasoning-parser",
    "glm45",
    "--chunked-prefill-size",
    "{chunk}",
    "--max-prefill-tokens",
    "{chunk}",
    "--cuda-graph-max-bs-decode",
    "1",
    "--sampling-backend",
    "pytorch",
    "--disable-flashinfer-autotune",
    "--watchdog-timeout",
    "1800",
    "--cuda-graph-backend-prefill",
    "disabled"
  ],
  "command_with_placement": [
    "--init-expert-location",
    "{placement}"
  ],
  "env": {
    "KT_EXPERT_SHM": "1",
    "KT_GPU_STREAM_DROP_CACHE": "{config_dir}",
    "KT_GPU_STREAM_EARLY_INIT": "1",
    "KT_GPU_STREAM_GROUP": "64",
    "KT_GPU_STREAM_PREFILL": "auto",
    "KT_GPU_STREAM_ROW_BLOCK": "8192",
    "KT_GPU_STREAM_SCALE_BYTES": "1",
    "KT_HANDOFF_PACK": "1",
    "KT_KV_HOT_DYNAMIC_RESIDENT": "1",
    "KT_KV_HOT_DYNAMIC_SLOTS": "1",
    "KT_KV_HOT_DYN_EVERY": "32",
    "KT_KV_HOT_EXTRA": "auto",
    "KT_KV_HOT_LEND": "0",
    "KT_KV_HOT_PLACEMENT": "{placement}",
    "KT_KV_HOT_SPARE_FLOOR_MB": "1024",
    "KT_KV_VMM": "1",
    "KT_KV_VMM_LIB": "{kv_vmm_lib}",
    "KT_LOAD_PREFETCH": "4",
    "KT_MXFP4_DEC_PFS": "1024",
    "KT_PREFILL_KV_LEND": "1",
    "KT_PREFILL_LEND": "1",
    "KT_PREFILL_LEND_HINT": "{cache_dir}/lend-hint-{key}",
    "KT_PREFILL_LEND_MAX_CHUNK": "32768",
    "KT_PREFILL_PLAN": "1",
    "KT_STREAM_MEMOPS": "1",
    "KT_TASKQUEUE_SPIN_US": "300",
    "NCCL_IB_DISABLE": "1",
    "NCCL_P2P_DISABLE": "1",
    "SGLANG_CACHE_DIR": "{cache_root}/sglang",
    "SGLANG_HOST_STAGED_ALLREDUCE": "1",
    "SGLANG_LL_ALLREDUCE": "1"
  },
  "env_by_tp": {
    "2": {}
  },
  "min_hot": 0
}

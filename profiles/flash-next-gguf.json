{
 "name": "flash-next-gguf",
 "description": "Qwen3.8-Flash-Next with the IQ3_S GGUF experts (ISTA-DASLab GSQ-RCO) through kt-kernel's LLAMAFILE backend and the recipe's GGUF streamer; the hot slots on the cards hold the same GGUF experts; the dense layers, the PLE table and the head come from the same GGUF in their GGUF types (--config-dir is a directory made by tools/make-config-dir.py); on the recipe's tree 2026-11-05",
 "weights": {
  "gguf": true,
  "experts_from": true,
  "embed_host": 1,
  "draft": "dir"
 },
 "defaults": {
  "2": {
   "kv_dtype": "bf16",
   "mamba_slots": 8,
   "pools": 2,
   "chunk": null,
   "threads": null,
   "free_min_gb": 1.0
  }
 },
 "command": [
  "-m",
  "sglang.launch_server",
  "--model-path",
  "{config_dir}",
  "--served-model-name",
  "{served_model_name}",
  "--model-impl",
  "sglang",
  "--load-format",
  "safetensors",
  "--dtype",
  "bfloat16",
  "--host",
  "{host}",
  "--port",
  "{port}",
  "--tp",
  "{tp}",
  "--numa-node",
  "{numa_nodes}",
  "--disable-custom-all-reduce",
  "--attention-backend",
  "trtllm_mha",
  "--linear-attn-prefill-backend",
  "flashinfer",
  "--linear-attn-decode-backend",
  "flashinfer",
  "--mamba-ssm-dtype",
  "bfloat16",
  "--kv-cache-dtype",
  "{kv_cache_dtype}",
  "--mamba-radix-cache-strategy",
  "extra_buffer_lazy",
  "--max-mamba-cache-size",
  "{mamba_slots}",
  "--ple-offload-embedding",
  "--ple-offload-backend",
  "file",
  "--moe-runner-backend",
  "flashinfer_cutlass",
  "--fp4-gemm-backend",
  "flashinfer_cutlass",
  "--language-model-only",
  "--kt-weight-path",
  "{experts_dir}",
  "--kt-method",
  "LLAMAFILE",
  "--kt-num-gpu-experts",
  "{hot}",
  "--kt-cpuinfer",
  "{threads}",
  "--kt-threadpool-count",
  "{pools}",
  "--kt-max-deferred-experts-per-token",
  "0",
  "--context-length",
  "{context_length}",
  "--max-total-tokens",
  "{context}",
  "--page-size",
  "64",
  "--chunked-prefill-size",
  "{chunk}",
  "--max-prefill-tokens",
  "{chunk}",
  "--max-running-requests",
  "1",
  "--cuda-graph-max-bs-decode",
  "1",
  "--mem-fraction-static",
  "{mem_fraction}",
  "--cuda-graph-backend-prefill",
  "disabled",
  "--cuda-graph-backend-decode",
  "full",
  "--disable-flashinfer-autotune",
  "--reasoning-parser",
  "qwen3",
  "--watchdog-timeout",
  "1800",
  "--warmups",
  "prefill_lengths"
 ],
 "env": {
  "KT_EXPERT_SHM": "1",
  "KT_GGUF_DENSE": "{experts_dir}",
  "KT_GPU_STREAM_DROP_CACHE": "{config_dir}",
  "KT_GPU_STREAM_EARLY_INIT": "1",
  "KT_GPU_STREAM_GROUP": "64",
  "KT_GPU_STREAM_PREFILL": "auto",
  "KT_GPU_STREAM_ROW_BLOCK": "8192",
  "KT_GPU_STREAM_SCALE_BYTES": "1",
  "KT_HANDOFF_PACK": "1",
  "KT_KV_HOT_DYNAMIC_RESIDENT": "1",
  "KT_KV_HOT_DYNAMIC_SLOTS": "1",
  "KT_KV_HOT_DYN_EVERY": "32",
  "KT_KV_HOT_EXTRA": "auto",
  "KT_KV_HOT_LEND": "1",
  "KT_KV_HOT_PLACEMENT": "{placement}",
  "KT_KV_HOT_SPARE_FLOOR_MB": "1024",
  "KT_LLAMAFILE_GROUP_MIN_LEN": "2",
  "KT_KV_VMM": "1",
  "KT_KV_VMM_LIB": "{kv_vmm_lib}",
  "KT_LOAD_PREFETCH": "4",
  "KT_MXFP4_DEC_PFS": "1024",
  "KT_PREFILL_KV_LEND": "1",
  "KT_PREFILL_LEND": "1",
  "KT_PREFILL_LEND_HINT": "{cache_dir}/lend-hint-{key}",
  "KT_PREFILL_LEND_MAX_CHUNK": "32768",
  "KT_PREFILL_PLAN": "1",
  "KT_STREAM_MEMOPS": "1",
  "KT_TASKQUEUE_SPIN_US": "300",
  "NCCL_IB_DISABLE": "1",
  "NCCL_P2P_DISABLE": "1",
  "SGLANG_CACHE_DIR": "{cache_root}/sglang",
  "SGLANG_EMBED_ON_HOST": "1",
  "SGLANG_HOST_STAGED_ALLREDUCE": "1",
  "SGLANG_LL_ALLREDUCE": "1",
  "SGLANG_QWEN4_PLE_FILE_SKIP_DEVICE_CHECK": "1",
  "SGLANG_WARMUP_PREFILL_LENGTHS": "1024,32768",
  "KT_GGUF_NOCOPY": "1",
  "KT_GGUF_ZEROCOPY": "1",
  "KT_GGUF_STREAM_MMQ": "1",
  "KT_GGUF_STREAM_SOURCE": "bank",
  "KT_GGUF_STREAM_RING": "16",
  "KT_GGUF_EXPERT_CACHE_GIB": "150",
  "KT_GGUF_CACHE_IQ1M_T": "0"
 },
 "env_by_tp": {
  "2": {}
 },
 "min_hot": 1,
 "command_with_placement": [
  "--init-expert-location",
  "{placement}"
 ],
 "command_with_draft": [
  "--speculative-algorithm",
  "NEXTN",
  "--speculative-num-steps",
  "1",
  "--speculative-eagle-topk",
  "1",
  "--speculative-num-draft-tokens",
  "2",
  "--speculative-draft-model-path",
  "{draft_dir}"
 ],
 "env_with_draft": {
  "KT_MTP_GGUF": "{draft_gguf}"
 }
}

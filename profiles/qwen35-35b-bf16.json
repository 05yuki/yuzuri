{
 "name": "qwen35-35b-bf16",
 "description": "Qwen3.5-35B-A3B bf16: bf16 CPU experts in kt-kernel, the bf16 streamed prefill (built at load), the hot lend with dynamic slots; captured 2026-11-05 from tools/start-qwen35-35b-bf16.sh",
 "weights": {
  "gguf": false,
  "experts_from": false,
  "embed_host": 0,
  "draft": "none"
 },
 "defaults": {
  "2": {
   "kv_dtype": "bf16",
   "mamba_slots": 8,
   "pools": 2,
   "chunk": null,
   "threads": null,
   "free_min_gb": 1.0
  }
 },
 "command": [
  "-m",
  "sglang.launch_server",
  "--model-path",
  "{config_dir}",
  "--load-format",
  "safetensors",
  "--trust-remote-code",
  "--served-model-name",
  "{served_model_name}",
  "--host",
  "0.0.0.0",
  "--port",
  "{port}",
  "--tensor-parallel-size",
  "{tp}",
  "--numa-node",
  "{numa_nodes}",
  "--disable-custom-all-reduce",
  "--kt-weight-path",
  "{config_dir}",
  "--kt-method",
  "BF16",
  "--kt-num-gpu-experts",
  "{hot}",
  "--kt-cpuinfer",
  "{threads}",
  "--kt-threadpool-count",
  "{pools}",
  "--context-length",
  "{context_length}",
  "--max-total-tokens",
  "{context}",
  "--mem-fraction-static",
  "{mem_fraction}",
  "--max-running-requests",
  "1",
  "--chunked-prefill-size",
  "{chunk}",
  "--max-prefill-tokens",
  "{chunk}",
  "--sampling-backend",
  "pytorch",
  "--watchdog-timeout",
  "1200",
  "--disable-radix-cache",
  "--enable-metrics",
  "--enable-cache-report",
  "--cuda-graph-backend-prefill",
  "disabled",
  "--disable-flashinfer-autotune"
 ],
 "env": {
  "KT_EXPERT_SHM": "1",
  "KT_FAST_PINNED": "0",
  "KT_GPU_STREAM_GRAPH": "1",
  "KT_GPU_STREAM_GROUP": "64",
  "KT_GPU_STREAM_PREFILL": "auto",
  "KT_KV_HOT_DYNAMIC_SLOTS": "1",
  "KT_KV_HOT_EXTRA": "auto",
  "KT_KV_HOT_LEND": "1",
  "KT_KV_HOT_SPARE_FLOOR_MB": "1024",
  "KT_KV_VMM": "1",
  "KT_KV_VMM_LIB": "{kv_vmm_lib}",
  "KT_PREFILL_LEND": "1",
  "KT_PREFILL_LEND_HINT": "{cache_dir}/lend-hint-{key}",
  "KT_STREAM_MEMOPS": "1",
  "KT_TASKQUEUE_SPIN_US": "300",
  "NCCL_IB_DISABLE": "1",
  "NCCL_P2P_DISABLE": "1",
  "SGLANG_HOST_STAGED_ALLREDUCE": "1",
  "SGLANG_LL_ALLREDUCE": "1",
  "SGLANG_MM_PROCESSOR_DEVICE": "cpu",
  "KT_GPU_STREAM_EARLY_INIT": "1",
  "KT_KV_HOT_DYNAMIC_RESIDENT": "1"
 },
 "env_by_tp": {
  "2": {}
 },
 "min_hot": 1,
 "command_with_placement": [
  "--init-expert-location",
  "{placement}"
 ]
}